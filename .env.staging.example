# Template for docker-compose.staging.yml — a disposable, production-like local rehearsal stack
# (real PostgreSQL, real MinIO as an S3-compatible backend, real Mailpit SMTP inspection, the
# actual production container images). See docs/deployment.md.
#
# `pnpm staging:up` copies this file to `.env.staging` (gitignored) on first run and fills in
# random secrets automatically — you do not need to hand-edit this file to get started. Every
# value below is a placeholder; none of it is a real secret.

# ---- PostgreSQL -------------------------------------------------------------------------------
POSTGRES_USER=portfolio_staging
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=portfolio_staging

# ---- MinIO (S3-compatible) ---------------------------------------------------------------------
MINIO_ROOT_USER=staging-minio-admin
MINIO_ROOT_PASSWORD=replace-me-min-8-chars
MINIO_BUCKET=portfolio-media-staging

# ---- API authentication (staging-only values — never reused for production) -------------------
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_ISSUER=sagar-portfolio-api-staging
ACCESS_TOKEN_AUDIENCE=sagar-portfolio-cms-staging
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret

# ---- Public origins -----------------------------------------------------------------------------
# Host-facing ports the compose stack publishes — change these if they collide with something
# already running locally.
WEB_PORT=13000
API_PORT=14000
POSTGRES_PORT=15432
WEB_URL=http://localhost:13000
PUBLIC_SITE_URL=http://localhost:13000
NEXT_PUBLIC_API_URL=http://localhost:14000/api/v1

# ---- Contact recipient (SMTP delivery is inspected in Mailpit, never actually sent anywhere) --
CONTACT_NOTIFICATION_TO=staging-owner@example.invalid

# ---- Release metadata ---------------------------------------------------------------------------
RELEASE_SHA=staging-local
