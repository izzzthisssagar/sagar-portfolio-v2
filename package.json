{
  "name": "sagar-portfolio-v2",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "admin:create": "tsx apps/api/scripts/admin-create.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:verify-backup": "bash scripts/db-verify-backup.sh",
    "db:backup-restore-rehearsal": "bash scripts/backup-restore-rehearsal.sh",
    "media:reconcile": "tsx apps/api/scripts/media-reconcile.ts",
    "secret-scan": "bash scripts/secret-scan.sh",
    "dependency-audit": "bash scripts/dependency-audit.sh",
    "config:check": "tsx apps/api/scripts/config-check.ts && tsx apps/web/scripts/config-check.ts",
    "smoke:containers": "bash scripts/container-smoke.sh",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "staging:up": "bash scripts/staging.sh up",
    "staging:down": "bash scripts/staging.sh down",
    "staging:logs": "bash scripts/staging.sh logs",
    "staging:smoke": "bash scripts/staging.sh smoke",
    "staging:reset": "bash scripts/staging.sh reset"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.62.1",
    "@prisma/client": "7.9.1",
    "@types/node": "24.10.0",
    "dotenv": "17.4.2",
    "prettier": "3.6.2",
    "prisma": "7.9.1",
    "tsx": "4.20.6",
    "turbo": "2.10.8",
    "typescript": "5.9.3"
  }
}
