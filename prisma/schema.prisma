generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum EvidenceStatus {
  CONFIRMED
  PENDING
  UNAVAILABLE
}

enum MediaStatus {
  QUARANTINED
  APPROVED
  REJECTED
  ARCHIVED
}

enum MediaCategory {
  IMAGE
  DOCUMENT
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
  SPAM
}

model AdminUser {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  failedLoginCount Int              @default(0)
  lockedUntil      DateTime?
  /// Bumped by logout-all. Every access token carries the tokenVersion it
  /// was signed with; JwtAuthGuard rejects a token whose version no longer
  /// matches, so logout-all invalidates already-issued access tokens
  /// immediately instead of only revoking refresh capability.
  tokenVersion     Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  sessions         RefreshSession[]
  auditLogs        AuditLog[]
  uploadedMedia    MediaAsset[]
}

model RefreshSession {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userId       String
  /// Snapshot of AdminUser.tokenVersion at the moment this session was
  /// created (login) or this session's parent was rotated. Refresh compares
  /// this against the admin's *current* tokenVersion — a mismatch means the
  /// session predates a logout-all or reuse-detection event and is rejected
  /// even if its own revokedAt sweep somehow raced and missed it.
  tokenVersion Int       @default(0)
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  action     String
  resource   String?
  resourceId String?
  ipHash     String?
  metadata   Json?
  createdAt  DateTime   @default(now())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Profile {
  id              String      @id @default(cuid())
  name            String
  headline        String
  bio             String
  location        String
  availability    String
  email           String?
  /// Legacy plain-string field, unenforced — superseded by CvDocument.active as the source of
  /// truth for which CV is live (see docs/sprint-3.md). Left in place rather than migrated away
  /// since nothing reads it.
  cvMediaId       String?
  portraitMediaId String?
  portraitMedia   MediaAsset? @relation(fields: [portraitMediaId], references: [id], onDelete: SetNull)
  updatedAt       DateTime    @updatedAt
}

model Experience {
  id           String            @id @default(cuid())
  organization String
  role         String
  startDate    DateTime
  endDate      DateTime?
  summary      String
  visibility   PublicationStatus @default(DRAFT)
  order        Int               @default(0)
}

model Education {
  id            String    @id @default(cuid())
  institution   String
  qualification String
  field         String?
  startDate     DateTime?
  endDate       DateTime?
  order         Int       @default(0)
}

model Capability {
  id     String            @id @default(cuid())
  group  String
  label  String
  order  Int               @default(0)
  status PublicationStatus @default(DRAFT)
}

model Project {
  id               String            @id @default(cuid())
  slug             String            @unique
  title            String
  summary          String
  overview         String?
  context          String?
  responsibilities String?
  systemMap        String?
  testStrategy     String?
  fixAndRetest     String?
  outcome          String?
  lessons          String?
  liveUrl          String?
  githubUrl        String?
  labels           String[]          @default([])
  sceneState       String            @default("inspection")
  status           PublicationStatus @default(DRAFT)
  order            Int               @default(0)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  metrics          ProjectMetric[]
  findings         ProjectFinding[]
  media            ProjectMedia[]
  posts            BlogPost[]
}

model ProjectMetric {
  id         String         @id @default(cuid())
  label      String
  value      String
  evidence   EvidenceStatus @default(PENDING)
  sourceNote String?
  order      Int            @default(0)
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectFinding {
  id             String         @id @default(cuid())
  title          String
  summary        String
  severity       String?
  evidenceStatus EvidenceStatus @default(PENDING)
  order          Int            @default(0)
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Project evidence — a MediaAsset attached to a Project with its own caption/status, distinct
/// from the asset's own approval status. Only APPROVED MediaAsset rows may be attached
/// (enforced in ProjectEvidenceService, not at the DB level, matching the rest of the app's
/// publish-time-validation convention). See docs/sprint-3.md.
model ProjectMedia {
  id             String         @id @default(cuid())
  title          String?
  caption        String?
  altText        String?
  sourceNote     String?
  evidenceStatus EvidenceStatus @default(PENDING)
  order          Int            @default(0)
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId        String
  media          MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([projectId, mediaId])
}

/// Tracks CV PDF versions uploaded through the media pipeline. Exactly one row may have
/// `active = true` at a time — enforced transactionally in CvService AND by a partial unique
/// index on (active) WHERE active = true (migration 20260803090512_cv_document_single_active_constraint;
/// not representable in this schema language, so it exists only in that migration's raw SQL).
/// The public CV download route serves whichever MediaAsset that row points to.
model CvDocument {
  id          String     @id @default(cuid())
  mediaId     String     @unique
  media       MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  title       String
  versionNote String?
  active      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model BlogPost {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  excerpt         String
  body            String
  readingTime     Int
  author          String
  status          PublicationStatus @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String
  seoDescription  String
  canonicalUrl    String?
  displayOrder    Int               @default(0)
  socialImageId   String?
  socialImage     MediaAsset?       @relation("BlogPostSocialImage", fields: [socialImageId], references: [id], onDelete: SetNull)
  featuredImageId String?
  featuredImage   MediaAsset?       @relation("BlogPostFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  categoryId      String
  category        BlogCategory      @relation(fields: [categoryId], references: [id])
  tags            BlogTag[]
  projects        Project[]
  relatedPosts    BlogPost[]        @relation("RelatedPosts")
  relatedTo       BlogPost[]        @relation("RelatedPosts")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, publishedAt])
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model LinkedInHighlight {
  id        String            @id @default(cuid())
  publicUrl String
  title     String
  summary   String
  postDate  DateTime
  imageId   String?
  order     Int               @default(0)
  featured  Boolean           @default(false)
  mode      String            @default("custom")
  status    PublicationStatus @default(DRAFT)
}

model GameConfig {
  id        String   @id @default(cuid())
  mode      String   @unique
  enabled   Boolean  @default(false)
  settings  Json
  updatedAt DateTime @updatedAt
}

model GameChallenge {
  id           String            @id @default(cuid())
  slug         String            @unique
  type         String
  title        String
  instructions String
  config       Json
  status       PublicationStatus @default(DRAFT)
  order        Int               @default(0)
}

model GameAchievement {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String
  threshold   Json
  status      PublicationStatus @default(DRAFT)
}

model ContactMessage {
  id               String                   @id @default(cuid())
  name             String
  email            String
  subject          String?
  company          String?
  message          String
  status           ContactStatus            @default(NEW)
  consentAt        DateTime
  createdAt        DateTime                 @default(now())
  ipHash           String?
  /// Set when a retry is claimed via POST /admin/messages/:id/retry-notification, cleared on
  /// completion. An atomic conditional UPDATE on this column is the claim mechanism, so two
  /// concurrent retry requests for the same message can never both send. See
  /// docs/contact-delivery.md.
  retryClaimedAt   DateTime?
  deliveryAttempts ContactDeliveryAttempt[]

  @@index([status, createdAt])
  @@index([email, createdAt])
}

enum ContactDeliveryAttemptStatus {
  /// Reserved before the real SMTP send is invoked — a slot has been durably claimed, but the
  /// outcome isn't known/persisted yet. A row stuck PENDING (the finalize write itself failed)
  /// still counts against MAX_DELIVERY_ATTEMPTS and is never automatically resent; it requires
  /// manual reconciliation, not a blind retry (see contact.service.ts).
  PENDING
  SUCCEEDED
  FAILED
}

/// One row per notification-delivery attempt for a ContactMessage — never the message body or
/// any personal data, only outcome. One row per real ContactNotificationAdapter.send() call,
/// always — never one row summarizing several sends (see docs/contact-delivery.md).
/// attemptNumber is monotonically increasing per ContactMessage, starting at 1; the
/// @@unique constraint is the database-enforced backstop against two concurrent allocations
/// ever landing on the same number (application code also serializes real sends via
/// ContactMessage.retryClaimedAt for manual retries).
/// The row is created with status=PENDING *before* the real send happens (reserveAttempt) and
/// updated to SUCCEEDED/FAILED afterward (finalizeAttempt) — a real send can never occur without
/// an already-persisted row claiming its slot, so MAX_DELIVERY_ATTEMPTS is enforced against real
/// sends even if the finalize write itself fails.
model ContactDeliveryAttempt {
  id               String                       @id @default(cuid())
  contactMessageId String
  contactMessage   ContactMessage               @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  attemptNumber    Int
  status           ContactDeliveryAttemptStatus @default(PENDING)
  reason           String?
  createdAt        DateTime                     @default(now())

  @@unique([contactMessageId, attemptNumber])
  @@index([contactMessageId])
}

model MediaAsset {
  id              String         @id @default(cuid())
  filename        String
  storageKey      String         @unique
  mimeType        String
  extension       String
  category        MediaCategory
  byteSize        Int
  sha256          String
  status          MediaStatus    @default(QUARANTINED)
  altText         String?
  decorative      Boolean        @default(false)
  caption         String?
  sourceNote      String?
  rejectionReason String?
  width           Int?
  height          Int?
  durationMs      Int?
  metadata        Json?
  createdById     String?
  createdBy       AdminUser?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime       @default(now())
  projects        ProjectMedia[]
  socialFor       BlogPost[]     @relation("BlogPostSocialImage")
  featuredFor     BlogPost[]     @relation("BlogPostFeaturedImage")
  portraitFor     Profile[]
  cvDocument      CvDocument?

  @@index([status])
  @@index([category])
  @@index([sha256])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
