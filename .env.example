NODE_ENV=development

# ---- Core -----------------------------------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
DATABASE_URL=postgresql://portfolio:replace-me@localhost:5432/sagar_portfolio?schema=public

# ---- Web (Next.js) — see apps/web/lib/env.ts ------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Canonical public origin used to build absolute URLs for page metadata, Open Graph/Twitter
# cards, JSON-LD, and sitemap.xml/robots.txt. Never inferred from request headers. Required in
# production (the web app fails closed if unset); defaults to http://localhost:3000 in
# development/test so nothing needs to be set locally. See docs/seo.md.
PUBLIC_SITE_URL=http://localhost:3000
# Serves the labelled static seed content when the API is unreachable, instead of failing
# visibly. Default false. Only ever set to true for local development convenience — CI, preview,
# staging, and production must leave this false (or unset) so an API outage is never silently
# masked.
ALLOW_STATIC_CONTENT_FALLBACK=false

# ---- Authentication ---------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_ISSUER=sagar-portfolio-api
ACCESS_TOKEN_AUDIENCE=sagar-portfolio-cms
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
REFRESH_TOKEN_TTL_DAYS=7

# ---- Administrator provisioning (pnpm admin:create only — never required to boot the API) -----
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-strong-local-password

# ---- Media (see docs/media-pipeline.md) --------------------------------------------------------
# local | s3 — production must set s3. Leave unset in development to use the local adapter.
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_LOCAL_PATH=./apps/api/.data/media
# The rest are required only when MEDIA_STORAGE_DRIVER=s3 (production, or staging against MinIO):
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_PUBLIC_BASE_URL=
MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_PDF_BYTES=15728640

# ---- Contact delivery (see docs/contact-delivery.md) -------------------------------------------
# capture | smtp — production must set smtp. "capture" persists the message without sending mail.
CONTACT_NOTIFICATION_DRIVER=capture
CONTACT_NOTIFICATION_TO=owner@example.invalid
# The rest are required only when CONTACT_NOTIFICATION_DRIVER=smtp:
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Operational (see docs/security-production.md) ---------------------------------------------
RATE_LIMIT_MAX=60
# false | 1 — "1" trusts exactly one reverse-proxy hop. Never guess; see docs/security-production.md.
TRUST_PROXY=false
LOG_LEVEL=info
LOG_FORMAT=
SERVICE_NAME=portfolio-api
RELEASE_SHA=unknown
HEALTH_INTERNAL_TOKEN=
SHUTDOWN_GRACE_PERIOD_MS=10000
# Prometheus-format internal metrics at GET /api/v1/internal/metrics — see docs/operations.md.
# Default off. Setting METRICS_ENABLED=true requires METRICS_TOKEN (16+ characters) or the API
# refuses to start at all (fails closed, in every environment, not only production).
METRICS_ENABLED=false
METRICS_TOKEN=
