NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Serves the labelled static seed content when the API is unreachable,
# instead of failing visibly. Default false. Only ever set to true for local
# development convenience — CI, preview, staging, and production must leave
# this false (or unset) so an API outage is never silently masked.
ALLOW_STATIC_CONTENT_FALLBACK=false
DATABASE_URL=postgresql://portfolio:replace-me@localhost:5432/sagar_portfolio?schema=public
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_ISSUER=sagar-portfolio-api
ACCESS_TOKEN_AUDIENCE=sagar-portfolio-cms
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD_HASH=argon2-hash-generated-outside-source-control
CONTACT_RECIPIENT_EMAIL=owner@example.invalid
MEDIA_ROOT=./var/media
# Canonical public origin used to build absolute URLs for page metadata, Open Graph/Twitter
# cards, JSON-LD, and sitemap.xml/robots.txt. Never inferred from request headers. Required in
# production (the web app fails closed if unset); defaults to http://localhost:3000 in
# development/test so nothing needs to be set locally. See docs/seo.md.
PUBLIC_SITE_URL=https://example.com
